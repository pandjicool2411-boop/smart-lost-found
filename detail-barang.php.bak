<?php require_once 'config/database.php';require_once 'includes/auth.php';require_once 'includes/ui.php';requireProfile($conn);$uid=(int)$_SESSION['user_id'];$id=(int)($_GET['id']??0);if($id<=0){header('Location: temukan.php');exit;}$st=$conn->prepare("SELECT r.*,c.name category_name,l.name location_name,u.name reporter_name,u.email reporter_email,u.student_status,u.semester,u.fakultas,u.nomor_hp FROM reports r LEFT JOIN categories c ON c.id=r.category_id LEFT JOIN locations l ON l.id=r.location_id JOIN users u ON u.id=r.user_id WHERE r.id=? LIMIT 1");$st->bind_param('i',$id);$st->execute();$r=$st->get_result()->fetch_assoc();$st->close();if(!$r){header('Location: temukan.php');exit;}$isOwner=(int)$r['user_id']===$uid;$claim=null;$lostForClaim=null;
if($r['type']==='FOUND'){$st=$conn->prepare("SELECT c.id,c.status,c.admin_note,c.finder_status,l.id lost_report_id,l.item_name lost_item_name FROM claims c JOIN reports l ON l.id=c.lost_report_id WHERE c.report_id=? AND c.user_id=? ORDER BY c.id DESC LIMIT 1");$st->bind_param('ii',$id,$uid);$st->execute();$claim=$st->get_result()->fetch_assoc();$st->close();if(!$claim){$st=$conn->prepare("SELECT m.lost_report_id,l.item_name FROM matches m JOIN reports l ON l.id=m.lost_report_id WHERE m.found_report_id=? AND l.user_id=? ORDER BY m.score DESC LIMIT 1");$st->bind_param('ii',$id,$uid);$st->execute();$lostForClaim=$st->get_result()->fetch_assoc();$st->close();}}
$titleForTop='Detail Barang';renderHead('Detail Barang');renderUserNav('search');?><div class="content animate-in"><a class="btn btn-light" href="javascript:history.back()">← Kembali</a><div class="card" style="margin-top:15px"><div class="detail-grid"><div><div class="detail-photo"><?php if($r['image']): ?><img src="uploads/<?= e($r['image']) ?>" alt="<?= e($r['item_name']) ?>"><?php else: ?>Tidak ada foto<?php endif; ?></div></div><div><span class="pill <?= $r['type']==='FOUND'?'pill-green':'pill-red' ?>"><?= $r['type']==='FOUND'?'BARANG DITEMUKAN':'BARANG HILANG' ?></span> <span class="pill pill-yellow"><?= e(statusLabel($r['status'])) ?></span><h1><?= e($r['item_name']) ?></h1><div class="meta">Kategori: <?= e($r['category_name']??'-') ?><br>Lokasi: <?= e($r['location_name']??'-') ?><br>Tanggal: <?= e($r['incident_date']) ?><br>Kondisi: <?= e($r['item_condition']??'-') ?><br>Dilaporkan oleh: <?= e($r['reporter_name']) ?></div><h3>Deskripsi</h3><p style="line-height:1.7;white-space:pre-wrap"><?= e($r['description']??'-') ?></p><?php if($r['type']==='FOUND' && !$isOwner): ?><div class="actions"><?php if($claim): ?><div class="notice notice-info" style="width:100%">Klaim kamu: <b><?= e(statusLabel($claim['status'])) ?></b><?php if($claim['admin_note']): ?><br><?= e($claim['admin_note']) ?><?php endif; ?></div><?php elseif($lostForClaim && $r['status']==='VERIFIED'): ?><a class="btn btn-green" href="klaim.php?report_id=<?= $r['id'] ?>&lost_report_id=<?= $lostForClaim['lost_report_id'] ?>">◇ Ajukan Klaim dari Laporan “<?= e($lostForClaim['item_name']) ?>”</a><?php elseif($r['status']!=='VERIFIED'): ?><div class="notice notice-warn">Barang belum diverifikasi admin.</div><?php else: ?><div class="notice notice-info">Belum ada kecocokan laporan kehilanganmu dengan barang ini.</div><?php endif; ?></div><?php endif; ?></div></div></div><section class="section"><div class="card"><h2>Data Pelapor / Penemu</h2><div class="grid grid-2"><div><b>Nama</b><p><?= e($r['reporter_name']) ?></p><b>Status</b><p><?= e($r['student_status']??'-') ?></p></div><div><b>Semester</b><p><?= e($r['semester']??'-') ?></p><b>Fakultas</b><p><?= e($r['fakultas']??'-') ?></p></div></div></div></section></div><?php renderFooter(); ?>
