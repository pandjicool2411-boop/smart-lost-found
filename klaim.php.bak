<?php require_once 'config/database.php';require_once 'includes/auth.php';require_once 'includes/ui.php';requireProfile($conn);$uid=(int)$_SESSION['user_id'];$foundId=(int)($_GET['report_id']??0);$lostId=(int)($_GET['lost_report_id']??0);if(!$foundId||!$lostId){header('Location: matching.php');exit;}
$st=$conn->prepare("SELECT f.id found_id,f.item_name found_name,f.description found_description,f.image found_image,f.status found_status,fc.name found_category,fl.name found_location,fu.name finder_name,l.id lost_id,l.item_name lost_name,l.description lost_description,l.image lost_image,l.status lost_status,lc.name lost_category,ll.name lost_location FROM reports f JOIN users fu ON fu.id=f.user_id LEFT JOIN categories fc ON fc.id=f.category_id LEFT JOIN locations fl ON fl.id=f.location_id JOIN reports l ON l.id=? LEFT JOIN categories lc ON lc.id=l.category_id LEFT JOIN locations ll ON ll.id=l.location_id WHERE f.id=? AND f.type='FOUND' AND l.type='LOST' AND l.user_id=? LIMIT 1");$st->bind_param('iii',$lostId,$foundId,$uid);$st->execute();$data=$st->get_result()->fetch_assoc();$st->close();if(!$data)die('Laporan kehilangan tidak valid atau bukan milikmu.');if($data['found_status']!=='VERIFIED'||$data['lost_status']!=='VERIFIED')die('Kedua laporan harus sudah diverifikasi admin.');$st=$conn->prepare('SELECT id,score FROM matches WHERE lost_report_id=? AND found_report_id=? LIMIT 1');$st->bind_param('ii',$lostId,$foundId);$st->execute();$match=$st->get_result()->fetch_assoc();$st->close();if(!$match)die('Klaim hanya dapat diajukan melalui kecocokan Smart Matching.');$err='';if($_SERVER['REQUEST_METHOD']==='POST'){$desc=trim($_POST['item_description']??'');$evidence=trim($_POST['evidence']??'');if(mb_strlen($desc)<10||mb_strlen($evidence)<10)$err='Ciri-ciri dan bukti kepemilikan masing-masing minimal 10 karakter.';else{$st=$conn->prepare('SELECT id,status FROM claims WHERE report_id=? AND lost_report_id=? AND user_id=? LIMIT 1');$st->bind_param('iii',$foundId,$lostId,$uid);$st->execute();$existing=$st->get_result()->fetch_assoc();$st->close();if($existing)$err='Kamu sudah mengajukan klaim untuk pasangan laporan ini.';else{$status='PENDING';$finder='PENDING';$st=$conn->prepare('INSERT INTO claims(report_id,user_id,item_description,evidence,status,lost_report_id,finder_status) VALUES(?,?,?,?,?,?,?)');$st->bind_param('iisssis',$foundId,$uid,$desc,$evidence,$status,$lostId,$finder);if($st->execute()){header('Location: klaim-saya.php?success=1');exit;}else$err='Gagal menyimpan klaim: '.$conn->error;$st->close();}}}
$titleForTop='Ajukan Klaim';renderHead('Ajukan Klaim');renderUserNav('klaim');?><div class="content animate-in"><div class="section-head"><div><h1 class="hero-title">Ajukan Klaim</h1><p class="muted">Klaim hanya bisa dibuat oleh pelapor kehilangan melalui hasil Smart Matching.</p></div></div><?php if($err): ?><div class="notice notice-error"><?= e($err) ?></div><?php endif; ?><div class="grid grid-2"><div class="card"><h2>Barang Hilang</h2><div class="meta">Laporan milik kamu</div><h3><?= e($data['lost_name']) ?></h3><p><?= e($data['lost_description']) ?></p><span class="pill pill-blue">Kecocokan <?= (int)$match['score'] ?>%</span></div><div class="card"><h2>Barang Ditemukan</h2><div class="meta">Ditemukan oleh <?= e($data['finder_name']) ?></div><h3><?= e($data['found_name']) ?></h3><p><?= e($data['found_description']) ?></p></div></div><div class="card form-card" style="margin-top:18px"><h2>Data Klaim</h2><form method="post"><div class="form-group"><label>Ciri-ciri barang yang kamu kenali</label><textarea name="item_description" rows="6" required placeholder="Contoh: warna, goresan, isi dompet, stiker, nomor seri, ciri yang hanya pemilik ketahui..."></textarea></div><div class="form-group"><label>Bukti kepemilikan</label><textarea name="evidence" rows="6" required placeholder="Jelaskan bukti yang dapat diperiksa penemu/admin."></textarea></div><button class="btn btn-green" type="submit">Kirim Klaim</button></form><div class="timeline"><div class="step current"><div class="dot">1</div>Pelapor</div><div class="step-line"></div><div class="step"><div class="dot">2</div>Penemu</div><div class="step-line"></div><div class="step"><div class="dot">3</div>Admin</div><div class="step-line"></div><div class="step"><div class="dot">4</div>Selesai</div></div></div></div><?php renderFooter(); ?>
